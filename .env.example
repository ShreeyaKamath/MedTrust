# Never commit .env or other local environment files.
# Never commit credentials or API keys.
# Never commit real patient information.
# Phase 2 infrastructure settings. No external services are required.
MEDTRUST_ENV=development
MEDTRUST_API_HOST=127.0.0.1
MEDTRUST_API_PORT=8000
MEDTRUST_LOG_LEVEL=INFO
# Optional Phase 3 local database. Replace both password placeholders locally.
POSTGRES_DB=medtrust
POSTGRES_USER=medtrust
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medtrust:replace-with-local-development-password@127.0.0.1:5432/medtrust
# Phase 5 local retrieval; no API key. Blank legacy URL uses the loopback default.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=medtrust_evidence_v1
MEDTRUST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEDTRUST_EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
MEDTRUST_RAG_CHUNK_SIZE=80
MEDTRUST_RAG_CHUNK_OVERLAP=16
MEDTRUST_RAG_TOP_K=5
MEDTRUST_RAG_RRF_CONSTANT=60

# Phase 6: mock is safe/offline; live execution is explicit. No provider keys here.
MEDTRUST_AGENT_RUNTIME=mock
MEDTRUST_OPENCLAW_TIMEOUT_SECONDS=60
MEDTRUST_OPENCLAW_HISTORY_AGENT=medtrust-history
MEDTRUST_OPENCLAW_LAB_AGENT=medtrust-lab
MEDTRUST_OPENCLAW_MEDICATION_AGENT=medtrust-medication
MEDTRUST_OPENCLAW_EVIDENCE_AGENT=medtrust-evidence
MEDTRUST_OPENCLAW_CRITIC_AGENT=medtrust-critic
MEDTRUST_OPENCLAW_COORDINATOR_AGENT=medtrust-coordinator
